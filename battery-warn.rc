#include <winresrc.h>
#include "battery-warn.rc.h"

LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL

IDI_APP_ICON ICON "battery-warn.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Battery Warn"
            VALUE "FileDescription",  "Battery Warn"
            VALUE "FileVersion",      "0.0.0.0"
            VALUE "InternalName",     "battery-warn.exe"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "BatteryWarn.exe"
            VALUE "ProductName",      "Battery Warn"
            VALUE "ProductVersion",   "0.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
